        {
            "name": "Client ID Gen",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/client/idgenerator"
        }
    ],
    "compounds": [
        {
            "name": "run all",
            "configurations": ["Gateway (API)", "ID Generator 1", "ID Generator 2", "Shortener service 1", "Restorer service 1", "Cache service 1", "Client ID Gen"]
        }
    ]
}
